#!/bin/bash
#SBATCH --job-name=room
#SBATCH --mail-type=FAIL,END
#SBATCH --qos=bala1s
#SBATCH --account=bala1s
#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --ntasks-per-node=32
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=4gb
#SBATCH --time=0-04:00:00
#SBATCH --partition=hpg-dev
#SBATCH --output=output_%j.out

date
hostname
pwd

echo "Running on ${SLURM_JOB_NUM_NODES} node(s) with ${SLURM_NTASKS} MPI tasks."
echo "HPC_PMIX=${HPC_PMIX}"
echo "SLURM_NTASKS=${SLURM_NTASKS}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK}"

module purge
module load intel/2025.1.0 openmpi/5.0.7

srun --mpi=list

srun --ntasks="${SLURM_NTASKS}" bash -c \
    'echo "rank=${SLURM_PROCID} local_rank=${SLURM_LOCALID} host=$(hostname)"'

srun --mpi="${HPC_PMIX}" --ntasks="${SLURM_NTASKS}" ./nek5000
sleep 5
exit 0;
