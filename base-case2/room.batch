#!/bin/bash
#SBATCH --job-name=ACH5_avgrun
#SBATCH --account=bala
#SBATCH --qos=bala1s-b
#SBATCH --mail-type=ALL
#SBATCH --mail-user=krishnap561997@gmail.com
#SBATCH --ntasks=64
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks-per-socket=8
#SBATCH --distribution=cyclic:cyclic
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=2gb
#SBATCH -t 4-00:00:00
#SBATCH -o logfile_%j.out
#SBATCH --partition=hpg-dev
cd /blue/bala1s/krishnap.kalivel/Nek5000/room_one_v24
echo room > SESSION.NAME
echo `pwd`'/' >> SESSION.NAME
echo '#################################################################'
echo '#################################################################'
echo Running on $SLURM_JOB_NUM_NODES nodes with $SLURM_NTASKS tasks.
echo Running executable file ~/bin/jobs/$SLURM_JOB_ID.x.
echo '#################################################################'
echo '#################################################################'
module purge
module load intel/2018
module load openmpi
sleep 30
cp nek5000 /home/krishnap.kalivel/bin/jobs/$SLURM_JOB_ID.x
srun --mpi=pmix_v3 /home/krishnap.kalivel/bin/jobs/$SLURM_JOB_ID.x
sleep 5
exit 0;
