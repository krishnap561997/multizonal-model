#
# room5x5 : 5 x 5 x 3.2 m room, 4-way cassette, LES + ppiclF
#
# STAGE 1 (spin-up, fluid only): as below (IFPARTICLE = 0, no startFrom).
# STAGE 2 (particles): copy the last room0.f* file to room0.ini, then set
#   startFrom = room0.ini time=0   and   userParam05 = 1
#
[GENERAL]
#startFrom = room0.ini time=0
stopAt = endTime
endTime = 600            # s of physical time (spin-up); adjust as needed
dt = 8.e-4
writeInterval = 2500     # fluid field output every 2 s
timeStepper = bdf3

filtering = explicit
filterWeight = 0.05
filterCutoffRatio = 0.9

userParam01 = 1250       # IOPART: particle output interval (steps)
userParam02 = 1.e-03     # inlet injection source length (m)     [not used: injection off]
userParam03 = 2          # particles per size per injection/inlet [not used]
userParam04 = 50         # end time of inlet injection (s)        [not used]
userParam05 = 0          # IFPARTICLE: 0 = fluid only, 1 = ppiclF particles
userParam06 = 5.0        # ACH (air changes per hour) -> inlet speed
userParam07 = 40.0       # inlet vane angle w.r.t. ceiling (deg)
userParam08 = 5.0e6      # total particles seeded at t=0 (all 10 sizes)

[MESH]
numberOfBCFields = 2
writeToFieldFile = yes

[PROBLEMTYPE]
equation = incompNS

[PRESSURE]
residualTol = 1e-04
writeToFieldFile = yes

[VELOCITY]
residualTol = 1e-06
density = 1.2041
viscosity = 1.81e-5

[TEMPERATURE]
solver = none
writeToFieldFile = yes

[SCALAR01] # udiff
solver = none
writeToFieldFile = yes
