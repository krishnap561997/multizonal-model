#!/bin/bash
#SBATCH --job-name=room5x5
#SBATCH --account=bala1s
#SBATCH --qos=bala1s-b
#SBATCH --mail-type=FAIL,END
##SBATCH --mail-user=YOUR_EMAIL@ufl.edu
#SBATCH --nodes=1
#SBATCH --ntasks=64              # 32 or 64 (SIZE has lpmin=32)
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=4gb
#SBATCH --time=4-00:00:00
#SBATCH --output=logfile_%j.out
## Quick tests: comment the 2 lines above and use
##SBATCH --partition=hpg-dev
##SBATCH --time=00:30:00
##SBATCH --qos=bala1s            # hpg-dev may not accept the burst QOS
#
# NOTE: do NOT use --distribution=cyclic:cyclic. The current Nek5000 file
# reader assumes each node holds a contiguous block of ranks; cyclic
# placement makes it fail with "Error reading .re2 mesh ierr=...".

cd "$SLURM_SUBMIT_DIR"
echo room                > SESSION.NAME
echo "$SLURM_SUBMIT_DIR/" >> SESSION.NAME

module purge
module load gcc/14.2.0 openmpi/5.0.10
module list 2>&1

# sbatch copies SLURM_* variables from the submitting shell, even with
# --export=NONE. When submitting from inside an interactive job (e.g. the
# VS Code tunnel), its step settings leak in and srun fails with
# "SLURM_MEM_PER_CPU ... SLURM_MEM_PER_NODE are mutually exclusive" or
# "Unable to satisfy cpu bind request". Drop them before srun.
unset ${!SLURM_CPU_BIND*} ${!SLURM_STEP*} ${!SLURM_PTY*} ${!SLURM_SRUN_COMM*} \
      SLURM_MEM_PER_NODE SLURM_MEM_PER_GPU SLURM_DISTRIBUTION \
      SLURM_LAUNCH_NODE_IPADDR SLURM_GTIDS SLURM_OOM_KILL_STEP

echo "Running on $SLURM_JOB_NUM_NODES node(s), $SLURM_NTASKS ranks, HPC_PMIX=$HPC_PMIX"
srun --mpi=${HPC_PMIX:-pmix} ./nek5000
exit 0
